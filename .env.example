# Copy to .env (never commit it). Every value is optional for the offline stack.
RR_DATABASE_URL=postgresql+asyncpg://researchrag:researchrag@localhost:5432/researchrag
RR_ENVIRONMENT=dev
# Comma-separated API keys accepted by the service (leave empty to disable auth in dev only)
RR_API_KEYS=dev-local-key
RR_PIPELINE_CONFIG=configs/default.yaml
RR_LOG_LEVEL=INFO
RR_LOG_PROMPTS=false
RR_REDACT_PII=true
RR_OTEL_EXPORTER_ENDPOINT=
RR_CORS_ORIGINS=http://localhost:8000
RR_RATE_LIMIT_PER_MINUTE=60
# Provider keys are read from the environment by the provider SDKs; export them in your shell.
OPENAI_API_KEY=
GEMINI_API_KEY=
